{
  "name": "ibantools-minimal",
  "version": "0.0.1",
  "description": "Validation, extraction and creation of IBAN, BBAN, BIC/SWIFT numbers plus some other helpful stuff like ISO 3166-1 alpha 2 country list",
  "keywords": [
    "IBAN",
    "BBAN",
    "BIC",
    "SEPA",
    "SWIFT",
    "ISO 3166-1 alpha-2"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/flash-oss/ibantools",
  "bugs": "https://github.com/flash-oss/ibantools/issues",
  "main": "build/ibantools.cjs",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./jsnext/ibantools.d.ts",
        "default": "./jsnext/ibantools.js"
      },
      "require": {
        "types": "./build/ibantools.d.cts",
        "default": "./build/ibantools.cjs"
      }
    }
  },
  "files": [
    "build",
    "jsnext",
    "LICENSE"
  ],
  "types": "build/ibantools.d.cts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-oss/ibantools.git"
  },
  "scripts": {
    "build": "npm run build-node && npm run build-module",
    "build-node": "rm -rf build && tsc --module commonjs --outDir ./build/ && mv build/ibantools.js build/ibantools.cjs && mv build/ibantools.d.ts build/ibantools.d.cts",
    "build-module": "rm -rf jsnext && tsc --outDir ./jsnext/",
    "test": "npm run build && mocha 'test/**/*.js'",
    "coverage": "npm run build && c8 mocha",
    "lint": "eslint .",
    "prepare": "npm run build-node",
    "prepublishOnly": "npm run build",
    "build-spec": "node script/builder.js",
    "update-registry": "node script/update-registry.js",
    "update-src": "node script/update-src.js"
  },
  "author": {
    "name": "Flash Payments",
    "url": "https://flash-payments.com"
  },
  "license": "MIT",
  "devDependencies": {
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.0.0",
    "lil-csv": "^1.4.6",
    "mocha": "^11.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
