{
  "name": "ibantools-flash",
  "version": "4.6.0",
  "description": "Validation, extraction and creation of IBAN, BBAN, BIC/SWIFT numbers plus some other helpful stuff like ISO 3136-1 alpha 2 country list",
  "keywords": [
    "IBAN",
    "BBAN",
    "BIC",
    "SEPA",
    "SWIFT",
    "ISO 3136-1 alpha-2"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/flash-oss/ibantools",
  "bugs": "https://github.com/flash-oss/ibantools/issues",
  "main": "build/ibantools.cjs",
  "type": "module",
  "module": "jsnext/ibantools.js",
  "exports": {
    ".": {
      "types": "./build/ibantools.d.ts",
      "import": "./jsnext/ibantools.js",
      "require": "./build/ibantools.cjs"
    }
  },
  "jspm": {
    "main": "jsnext/ibantools.js",
    "format": "esm"
  },
  "files": [
    "build",
    "jsnext",
    "LICENSE",
    "typings.json"
  ],
  "types": "build/ibantools.d.ts",
  "typescript": {
    "definition": "build/ibantools.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-oss/ibantools.git"
  },
  "scripts": {
    "build": "npm run build-node && npm run build-module",
    "build-node": "rm -rf build && tsc --module commonjs --outDir ./build/ && cp ./build/ibantools.js ./build/ibantools.cjs",
    "build-module": "rm -rf jsnext && tsc --outDir ./jsnext/",
    "test": "npm run build && mocha 'test/**/*.js'",
    "coverage": "npm run build && c8 mocha && c8 report -e \".js\" --reporter=text-lcov > test.lcov",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.js'",
    "prepare": "npm run build-node",
    "prepublishOnly": "npm run build",
    "build-spec": "node script/builder.js",
    "update-registry": "node script/update-registry.js",
    "update-src": "node script/update-src.js",
    "all": "npm run test && npm run lint"
  },
  "author": {
    "name": "Flash Payments",
    "url": "https://flash-payments.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58",
    "@typescript-eslint/parser": "^8.58",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "coveralls-next": "^6.0.1",
    "docdash": "^2.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "lil-csv": "^1.4.6",
    "mocha": "^11.0.1",
    "mocha-lcov-reporter": "^1.2.0",
    "prettier": "^3.0.3",
    "requirejs": "^2.3.6",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "source-map": "^0.8.0-beta.0"
  }
}
